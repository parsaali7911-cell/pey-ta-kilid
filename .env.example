NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
DATABASE_URL=postgresql://peytakilid:peytakilid@127.0.0.1:5432/peytakilid?schema=public
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BOOTSTRAP_ADMIN_EMAIL=admin@peytakilid.local
NEXT_PUBLIC_DEFAULT_LOCALE=fa
# Intent NL: set AI_PROVIDER=openai + OPENAI_API_KEY to enrich homepage demand understanding
AI_PROVIDER=none
AI_MAX_COMPLETE_TOKENS=512
AI_MAX_EMBED_TEXTS=16
AI_MAX_VISION_TOKENS=256
# Required only when AI_PROVIDER=openai — never commit real keys
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_INPUT_COST_PER_1M=0.15
OPENAI_OUTPUT_COST_PER_1M=0.6
